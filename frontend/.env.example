# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Required in production; optional locally.
AUTH_URL=http://localhost:3000
# Trust the local host header in dev.
AUTH_TRUST_HOST=true

# ─── Google OAuth ────────────────────────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Application type: Web application
# Authorised JavaScript origin:  http://localhost:3000
# Authorised redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── Backend API ─────────────────────────────────────────────────────────────
# Used by the browser. Must be reachable from the client.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Used server-side by the NextAuth jwt callback to exchange the Google token.
BACKEND_URL=http://localhost:4000
